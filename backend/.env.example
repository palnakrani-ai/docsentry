# Copy to backend/.env and fill in. .env is gitignored, keep it that way.
# Real deployments (Render, Spaces) set these as platform env vars or build
# secrets instead of shipping a file.

# --- Required ---------------------------------------------------------------

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Optional, defaults shown -----------------------------------------------

# Answer model.
GEMINI_MODEL=gemini-flash-lite-latest

# Embedding model. Falls back to gemini-embedding-2 if this one 404s.
# (text-embedding-004 was the old fallback and has since been retired.)
# Changing it means re-running `python -m app.ingest`: query embeddings have
# to come from the same model that built the index.
GEMINI_EMBED_MODEL=gemini-embedding-2

# --- Optional, LangSmith tracing --------------------------------------------
# Tracing stays off unless LANGSMITH_TRACING is exactly "true". With all three
# set, every request appears as a four-step trace (retrieve, grounding gate,
# generate, verify) with token counts and per-step latency.
# Key from https://smith.langchain.com/settings

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=docsentry
