# Caddy terminates TLS and is the only way into this box.
#
# {$DOMAIN} comes from the environment. Set it to the real hostname in .env and
# Caddy gets a Let's Encrypt certificate on first boot. Left as the default
# `localhost`, Caddy issues its own local certificate instead, which is what
# makes this file testable without owning a domain.
#
# Cloudflare sits in front of this. Use a DNS-only (grey cloud) record while
# issuing the first certificate: with the orange cloud on, Cloudflare terminates
# TLS itself and the HTTP-01 challenge never reaches Caddy.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Grafana first: a more specific path has to be matched before the catch-all
	# reverse proxy below, or every dashboard request lands on the API.
	#
	# `handle`, not `handle_path`. handle_path strips the /grafana prefix, and
	# Grafana runs with GF_SERVER_SERVE_FROM_SUB_PATH=true, so it expects the
	# prefix to still be there. Stripping it makes Grafana redirect to the path
	# it just received, which is a 301 loop back to itself.
	handle /grafana* {
		reverse_proxy grafana:3000
	}

	handle {
		reverse_proxy api:7860 {
			# The app rate limits per client IP. Without this every request
			# arrives from the Caddy container's address and the whole internet
			# shares one bucket.
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	header {
		# The frontend is served same-origin by the API, so it needs no
		# cross-origin anything.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}
