# Copy to .env next to docker-compose.yml. Never commit it.
#
#   docker compose up -d --build

# --- Required ---------------------------------------------------------------

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase session pooler (port 5432), not the transaction pooler: transaction
# mode breaks SQLAlchemy's prepared statements unless prepare_threshold=0 is set.
# Direct connections are IPv6-only on the free tier.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres

# The hostname Caddy gets a certificate for. Leave as localhost to test the
# whole stack without a domain: Caddy then issues its own local certificate.
DOMAIN=localhost
ACME_EMAIL=

# Grafana admin login.
GRAFANA_PASSWORD=

# The same database again, in the parts Grafana provisioning understands.
# Use a read-only role here. Grafana runs arbitrary dashboard SQL.
DS_DB_HOST=<pooler-host>
DS_DB_PORT=5432
DS_DB_NAME=postgres
DS_DB_USER=postgres.<project-ref>
DS_DB_PASSWORD=
DS_DB_SSLMODE=require

# --- Optional ---------------------------------------------------------------

# Error reporting. Inert when empty.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Tracing. Inert unless LANGSMITH_TRACING is exactly "true".
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=docsentry
